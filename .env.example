# Copy to .env and fill in. Nothing loads this file automatically: export the variables
# into your shell before running the watchers, e.g.
#   bash:        set -a; source .env; set +a
#   PowerShell:  $env:PANDASCORE_TOKEN = "..."

# PandaScore API token (only needed for watchers/panda_cs2_watcher).
# The token is read from this environment variable and nowhere else.
PANDASCORE_TOKEN=

# Optional: where the SQLite events bus lives. Default: data/events.sqlite in the repo.
# LATENCY_LAB_DB=data/events.sqlite
